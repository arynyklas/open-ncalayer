/target/
# The example plugin's own workspace, when built in place.
/crates/oncl-pdk/example/target/
# The plugin ports' workspace, when built in place.
/plugins/target/
# Standalone verification of locally patched cryptographic dependencies.
/vendor/streebog/target/
/vendor/hmac/target/
/.worktrees/
# Built programs and downloads; nothing like them is committed.
*.exe
*.dll
*.dylib
*.jar
*.zip
# Except the synthetic fixtures of the upstream watcher, built from our sources.
!/fixtures/upstream/*.exe
!/fixtures/upstream/*.jar
!/fixtures/upstream/*.zip
# Generated by `cargo xtask ext build` from `oncl_ipc::ids::HOST_NAME`.
/extension/src/host.js
# Python bytecode and per-task cargo target directories (e.g. target-native-smoke).
__pycache__/
/target-*/
