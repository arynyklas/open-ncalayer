{
  "manifest_version": 2,
  "name": "OpenNCALayer",
  "version": "{{VERSION}}",
  "description": "Connects sites built for NCALayer to OpenNCALayer through native messaging.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{{FIREFOX_ID}}",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["host.js", "background.js"],
    "persistent": true
  },
  "permissions": ["nativeMessaging", "<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shim.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
