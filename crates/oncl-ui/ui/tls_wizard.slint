// The TLS wizard: the certificate for browsers and its trust (status), where it comes from
// (own CA, mkcert, an imported one), installing the CA into the user's trust stores, and the
// check in the browser. Every write to a trust store waits for a confirmation here. The texts
// of the states are composed in Rust.

import { Button, CheckBox, ComboBox, ListView, Palette, TabWidget } from "std-widgets.slint";
import { ActionBar, BusyRow, DialogScroll, EscapeScope, FieldLabel, Hint, LinkButton, Metrics, NameText, PathField, StatusArea, Subheading, Tone } from "common.slint";

// A trust store the install buttons act on.
export struct TrustStoreRow {
    label: string,
    state: string,
    selected: bool,
}

// A browser that opened the self-test page.
export struct BrowserRow {
    browser: string,
    seen: string,
}

export component TlsWizardWindow inherits Window {
    title: @tr("Certificate for browsers");
    min-width: Metrics.wide-min-width;
    min-height: Metrics.wide-min-height;
    preferred-width: 640px;
    preferred-height: 560px;

    // 0: status, 1: source, 2: installation, 3: check.
    in-out property <int> tab;
    // An action runs (or the state loads): the buttons wait.
    in property <bool> busy;
    // The outcome of the last action, and whether it failed.
    in property <string> message;
    in property <bool> message-is-error;
    // A question to confirm before an action; empty: none.
    in property <string> confirm-text;

    in property <string> status-text;
    in property <string> trust-text;

    // 0: own CA, 1: mkcert, 2: an imported certificate.
    in-out property <int> source;
    in property <string> mkcert-text;
    in property <bool> mkcert-found;
    in-out property <bool> mkcert-consent;
    in-out property <string> chain-path;
    in-out property <string> key-path;

    in property <[TrustStoreRow]> stores;
    in property <string> install-text;
    in property <bool> can-install-ca;
    in property <string> replaced-text;
    in property <bool> has-replaced;

    in property <string> selftest-url;
    in property <[BrowserRow]> browsers;
    // «Close» is inside the window, whatever the texts and the scale.
    out property <bool> actions-reachable: actions.inside(root.width, root.height);

    callback refresh();
    callback issue();
    // The mkcert consent box changed (a saved mkcert certificate records it at once).
    callback consent-toggled(bool);
    callback browse-chain();
    callback browse-key();
    callback store-toggled(int, bool);
    callback install-ca();
    callback remove-ca();
    callback install-nca();
    callback remove-nca();
    callback remove-replaced();
    callback open-selftest();
    callback confirm();
    callback cancel-confirm();
    callback dismiss();

    private property <bool> can-issue: !root.busy && (root.source == 0 || (root.source == 1 && root.mkcert-found && root.mkcert-consent) || (root.source == 2 && !root.chain-path.is-empty && !root.key-path.is-empty));
    private property <bool> asking: !root.confirm-text.is-empty;

    // The question gone (answered or not), the keyboard comes back to the window instead of
    // being lost with the question's button.
    changed asking => {
        if !root.asking {
            keys.focus();
        }
    }

    // Escape works from the first moment: the focus starts here, and Tab goes on from it.
    forward-focus: keys;
    keys := EscapeScope {
        escape => {
            if root.asking {
                // A write to a trust store is refused by Escape, as by Enter.
                root.cancel-confirm();
            } else if !root.busy {
                root.dismiss();
            }
        }
        VerticalLayout {
            padding: Metrics.pad;
            spacing: Metrics.gap;
            TabWidget {
                current-index <=> root.tab;
                Tab {
                    title: @tr("Status");
                    VerticalLayout {
                        spacing: Metrics.gap;
                        DialogScroll {
                            Text {
                                text: root.status-text;
                                wrap: char-wrap;
                            }

                            Subheading {
                                text: @tr("Trust (read only)");
                            }

                            Text {
                                text: root.trust-text;
                                wrap: char-wrap;
                            }
                        }

                        ActionBar {
                            Button {
                                text: @tr("Check again");
                                enabled: !root.busy && !root.asking;
                                clicked => {
                                    root.refresh();
                                }
                            }
                        }
                    }
                }

                Tab {
                    title: @tr("Source");
                    VerticalLayout {
                        spacing: Metrics.gap;
                        DialogScroll {
                            FieldLabel {
                                text: @tr("Source");
                            }

                            ComboBox {
                                enabled: !root.busy && !root.asking;
                                model: [@tr("Create my own certificate"), @tr("Use mkcert"), @tr("My own certificate (import)")];
                                current-index <=> root.source;
                                accessible-label: @tr("Source");
                            }

                            if root.source == 0: Text {
                                text: @tr("OpenNCALayer creates a local CA that can only certify 127.0.0.1, ::1 and localhost, issues the certificate and destroys the CA's key at once. Install the new CA on the «Installation» tab.");
                                wrap: word-wrap;
                            }
                            if root.source == 1: VerticalLayout {
                                spacing: Metrics.gap;
                                Text {
                                    text: root.mkcert-text;
                                    wrap: char-wrap;
                                }

                                // The consent's long text wraps beside its box; the text is
                                // the box's label, and clicking it toggles the box too.
                                HorizontalLayout {
                                    spacing: 4px;
                                    consent := CheckBox {
                                        enabled: !root.busy && !root.asking && root.mkcert-found;
                                        checked <=> root.mkcert-consent;
                                        accessible-label: consent-text.text;
                                        toggled => {
                                            root.consent-toggled(self.checked);
                                        }
                                    }

                                    consent-text := Text {
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                        text: @tr("I agree that OpenNCALayer reads the mkcert CA key rootCA-key.pem at every renewal (it is never copied). Untick to withdraw the consent.");
                                        TouchArea {
                                            enabled: consent.enabled;
                                            clicked => {
                                                root.mkcert-consent = !root.mkcert-consent;
                                                root.consent-toggled(root.mkcert-consent);
                                            }
                                        }
                                    }
                                }
                            }
                            if root.source == 2: VerticalLayout {
                                spacing: Metrics.gap;
                                Text {
                                    text: @tr("A certificate for 127.0.0.1 with serverAuth, ECDSA P-256/P-384 or RSA of 2048 bits and more, not signed with SHA-1, and its key (PEM).");
                                    wrap: word-wrap;
                                }

                                PathField {
                                    label: @tr("Certificate chain (PEM)");
                                    placeholder: @tr("Certificate chain (PEM)");
                                    field-enabled: !root.busy && !root.asking;
                                    text <=> root.chain-path;
                                    browse => {
                                        root.browse-chain();
                                    }
                                }

                                PathField {
                                    label: @tr("Private key (PEM)");
                                    placeholder: @tr("Private key (PEM)");
                                    field-enabled: !root.busy && !root.asking;
                                    text <=> root.key-path;
                                    browse => {
                                        root.browse-key();
                                    }
                                }
                            }
                        }

                        ActionBar {
                            Button {
                                text: root.source == 2 ? @tr("Use this certificate") : @tr("Issue the certificate");
                                primary: true;
                                enabled: root.can-issue && !root.asking;
                                clicked => {
                                    root.issue();
                                }
                            }
                        }
                    }
                }

                Tab {
                    title: @tr("Installation");
                    VerticalLayout {
                        DialogScroll {
                            Text {
                                text: root.install-text;
                                wrap: char-wrap;
                            }

                            for row[i] in root.stores: HorizontalLayout {
                                padding: 4px;
                                spacing: Metrics.gap;
                                CheckBox {
                                    enabled: !root.busy && !root.asking;
                                    checked: row.selected;
                                    accessible-label: row.label;
                                    toggled => {
                                        root.store-toggled(i, self.checked);
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    NameText {
                                        text: row.label;
                                        font-weight: 700;
                                    }

                                    Text {
                                        text: row.state;
                                        wrap: char-wrap;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: Metrics.gap;
                                alignment: start;
                                Button {
                                    text: @tr("Install my CA into the user's store");
                                    enabled: !root.busy && !root.asking && root.can-install-ca;
                                    clicked => {
                                        root.install-ca();
                                    }
                                }

                                Button {
                                    text: @tr("Remove");
                                    enabled: !root.busy && !root.asking && root.can-install-ca;
                                    clicked => {
                                        root.remove-ca();
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: Metrics.gap;
                                alignment: start;
                                Button {
                                    text: @tr("Download and install the NCA roots");
                                    enabled: !root.busy && !root.asking;
                                    clicked => {
                                        root.install-nca();
                                    }
                                }

                                Button {
                                    text: @tr("Remove the NCA roots");
                                    enabled: !root.busy && !root.asking;
                                    clicked => {
                                        root.remove-nca();
                                    }
                                }
                            }

                            if root.has-replaced: VerticalLayout {
                                spacing: Metrics.gap;
                                Text {
                                    text: root.replaced-text;
                                    wrap: char-wrap;
                                }

                                HorizontalLayout {
                                    alignment: start;
                                    Button {
                                        text: @tr("Remove the old one");
                                        enabled: !root.busy && !root.asking;
                                        clicked => {
                                            root.remove-replaced();
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                Tab {
                    title: @tr("Check");
                    VerticalLayout {
                        DialogScroll {
                            Text {
                                text: @tr("Open the self-test page in each browser you use. A browser that opened the page and ran it appears in the list below. Only a page that opened without a certificate warning means the browser trusts the certificate: if you clicked through a warning, the browser is listed but does not trust it.");
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                alignment: start;
                                Button {
                                    text: @tr("Open the check in the browser");
                                    enabled: !root.asking;
                                    clicked => {
                                        root.open-selftest();
                                    }
                                }
                            }

                            NameText {
                                text: root.selftest-url;
                                color: Tone.quiet();
                            }

                            for row in root.browsers: HorizontalLayout {
                                padding: 4px;
                                spacing: Metrics.gap;
                                Text {
                                    text: "✓";
                                    color: Tone.success();
                                    font-weight: 700;
                                }

                                NameText {
                                    text: row.browser;
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: row.seen;
                                    color: Tone.quiet();
                                }
                            }

                            if root.browsers.length == 0: Hint {
                                text: @tr("No browser has opened the page yet.");
                            }
                        }
                    }
                }
            }

            if root.busy: BusyRow {
                label: @tr("Please wait…");
            }
            if !root.message.is-empty: StatusArea {
                message: root.message;
                error: root.message-is-error;
            }
            actions := ActionBar {
                Button {
                    text: @tr("Close");
                    primary: true;
                    // Closing waits for the running action: its outcome is shown here.
                    enabled: !root.busy && !root.asking;
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }

        // The confirmation, above everything else; the window's size does not depend on it. The
        // keyboard goes to it when it appears, on «Cancel»: Enter alone writes nothing.
        if root.asking: Rectangle {
            x: 0;
            y: 0;
            width: root.width;
            height: root.height;
            background: #00000080;
            TouchArea { }

            Rectangle {
                width: min(root.width - 24px, 520px);
                height: min(question.preferred-height, root.height - 24px);
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                background: Palette.background;
                border-radius: 6px;
                border-width: 1px;
                border-color: Palette.border;
                question := VerticalLayout {
                    width: parent.width;
                    padding: Metrics.pad;
                    spacing: Metrics.gap;
                    init => {
                        refuse.focus();
                    }
                    StatusArea {
                        message: root.confirm-text;
                        neutral: true;
                        limit: 240px;
                    }

                    ActionBar {
                        Button {
                            text: @tr("Yes");
                            clicked => {
                                root.confirm();
                            }
                        }

                        refuse := Button {
                            text: @tr("Cancel");
                            primary: true;
                            clicked => {
                                root.cancel-confirm();
                            }
                        }
                    }
                }
            }
        }
    }
}
