// «Установка плагина»: who asks, the plugin, the installed version it replaces, what it
// replaces of the original, what it may do and, for a file the user chose, a warning;
// «Установить» (enabled a moment after the window appears) or «Отмена». The texts are composed
// in Rust.

import { Button, Palette } from "std-widgets.slint";
import { ActionBar, DialogScroll, EscapeScope, Metrics, NameText, PluginFrame, Subheading, Tone } from "common.slint";

// One operation of the plugin for the manual-tools window. `heading` and `lines` are the
// host's own words, built from checked fields only (an identifier, the kinds of key use and
// the profile the core forces, the network, the server flag, what an update adds). `calls` and
// `label` are the plugin's: `label` is its own text, shown plain, in a frame of its own.
export struct OperationBlock {
    heading: string,
    lines: [string],
    calls: string,
    label: string,
    // More of the plugin's own text (its XPaths), in the same frame.
    plugin-lines: [string],
}

export component InstallPluginWindow inherits Window {
    title: root.window-title;
    always-on-top: true;
    min-width: Metrics.dialog-min-width;
    min-height: Metrics.min-height;
    max-width: 640px;
    forward-focus: cancel-button;

    // «Установка плагина» or «Обновление плагина».
    in property <string> window-title: @tr("Plugin installation");
    // The confirming button names its action: «Установить» or «Обновить», never a plain OK.
    in property <string> confirm-text: @tr("Install");
    // «Сайт … просит установить плагин», or empty.
    in property <string> asker;
    // The plugin's name and version.
    in property <string> plugin;
    // The installed version of the same plugin it replaces, or empty.
    in property <string> replacing;
    // What original bundle it replaces, or empty.
    in property <string> replaces;
    // The heading of `capabilities`.
    in property <string> may;
    in property <[string]> capabilities;
    // The heading of `operations`, or empty without any.
    in property <string> operations-heading;
    in property <[OperationBlock]> operations;
    // Not from the catalog: the warning, or empty.
    in property <string> warning;
    // «Установить» works: set a moment after the window appears.
    in-out property <bool> can-install: false;
    // The buttons are inside the window, whatever the text and the scale.
    out property <bool> actions-reachable: actions.inside(root.width, root.height);
    // What the plugin may do (the host's consent text) is in the first screenful.
    // How tall the text is (its lines counted), for the tests.
    out property <length> body-content: body.content-height;
    // The first operation is in the first screenful, however many capabilities follow.
    out property <bool> operations-in-view: ops-mark.absolute-position.y + ops-mark.height <= body.absolute-position.y + body.visible-height;
    // How far the body is scrolled (zero or negative).
    out property <length> body-y: body.content-y;
    out property <bool> consent-in-view: may-text.absolute-position.y + may-text.height <= body.absolute-position.y + body.visible-height;

    callback answer(bool);

    EscapeScope {
        escape => {
            root.answer(false);
        }
        VerticalLayout {
            padding: Metrics.pad;
            spacing: Metrics.gap;
            body := DialogScroll {
                if root.asker != "": NameText {
                    text: root.asker;
                }

                Subheading {
                    text: root.plugin;
                    wrap: char-wrap;
                }

                // What the plugin may do comes first, with the warning above it: the host's
                // consent text is in view before anything else the plugin says.
                if root.warning != "": Text {
                    text: root.warning;
                    wrap: word-wrap;
                    font-weight: 700;
                    color: Tone.error();
                }

                // The operations come before the (long) list of capabilities: what the key is
                // used for is read first.
                ops-mark := Rectangle {
                    height: 1px;
                }

                if root.operations-heading != "": Text {
                    text: root.operations-heading;
                    wrap: word-wrap;
                }

                // The plugin's own label never mixes with the host's lines: it is under its
                // own heading, in a frame.
                for block in root.operations: VerticalLayout {
                    spacing: Metrics.gap / 2;
                    Subheading {
                        text: block.heading;
                        wrap: char-wrap;
                    }

                    for line in block.lines: NameText {
                        text: "• " + line;
                    }

                    PluginFrame {
                        caption: block.calls;
                        label: block.label;
                        lines: block.plugin-lines;
                    }
                }

                may-text := Text {
                    text: root.may;
                    wrap: word-wrap;
                }

                // Manifest strings (host patterns, URL prefixes): a lookalike host is read to its
                // end, so these break anywhere.
                for line in root.capabilities: NameText {
                    text: "• " + line;
                }

                if root.replacing != "": Text {
                    text: root.replacing;
                    wrap: word-wrap;
                }

                if root.replaces != "": Text {
                    text: root.replaces;
                    wrap: word-wrap;
                }
            }

            actions := ActionBar {
                Button {
                    text: root.confirm-text;
                    accessible-label: root.confirm-text;
                    enabled: root.can-install;
                    clicked => {
                        root.answer(true);
                    }
                }

                // The default: Enter alone does not install.
                cancel-button := Button {
                    text: @tr("Cancel");
                    primary: true;
                    clicked => {
                        root.answer(false);
                    }
                }
            }
        }
    }
}
