// The reader dialog of the legacy Applet's `browseKeyStore`: a reader holding a token of one
// storage.

import { Button, StandardListView } from "std-widgets.slint";
import { ActionBar, DialogScroll, EscapeScope, Hint, Metrics, NameText, StatusText, Subheading } from "common.slint";

export component ReaderDialog inherits Window {
    title: "OpenNCALayer";
    always-on-top: true;
    min-width: Metrics.dialog-min-width;
    min-height: Metrics.min-height;

    // The requesting page's origin.
    in property <string> origin;
    // The name of the token storage.
    in property <string> storage;
    // The readers holding a token of that storage.
    in property <[StandardListViewItem]> readers;
    // Index of the chosen reader, -1 for none.
    in-out property <int> reader-index: -1;
    // Why no reader is listed, or that the readers are being searched for; empty otherwise.
    in property <string> reader-note;
    // The readers are being searched for: «Refresh» waits.
    in property <bool> scanning;
    // The buttons are inside the window, whatever the text and the scale.
    out property <bool> actions-reachable: actions.inside(root.width, root.height);

    callback choose();
    callback cancel();
    callback refresh();

    private property <bool> can-choose: root.reader-index >= 0 && root.reader-index < root.readers.length;

    // Escape works from the first moment: the focus starts here, and Tab goes on from it.
    forward-focus: keys;
    keys := EscapeScope {
        escape => {
            root.cancel();
        }
        VerticalLayout {
            padding: Metrics.pad;
            spacing: Metrics.gap;
            DialogScroll {
                NameText {
                    text: @tr("Request from: {}", root.origin);
                }

                Subheading {
                    text: @tr("Key storage selection");
                }

                NameText {
                    text: @tr("Storage type: {}", root.storage);
                }

                StandardListView {
                    min-height: 120px;
                    model: root.readers;
                    current-item <=> root.reader-index;
                    accessible-label: @tr("Key storage selection");
                }

                if !root.reader-note.is-empty: Text {
                    text: root.reader-note;
                    wrap: char-wrap;
                }

                Hint {
                    text: @tr("Token support is experimental: checked on an emulator only");
                    font-italic: true;
                }
            }

            actions := ActionBar {
                Button {
                    text: @tr("Refresh");
                    enabled: !root.scanning;
                    clicked => {
                        root.refresh();
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                Button {
                    text: @tr("Choose");
                    primary: true;
                    enabled: root.can-choose;
                    clicked => {
                        root.choose();
                    }
                }

                Button {
                    text: @tr("Cancel");
                    clicked => {
                        root.cancel();
                    }
                }
            }
        }
    }
}
