// The certificate request dialog of generateCsr: storage, folder for the new key files and,
// without a password from the page, the key file password.

import { Button, CheckBox, LineEdit, Palette, VerticalBox } from "std-widgets.slint";
import { StorageRow } from "storage.slint";

export component CsrDialog inherits Window {
    title: "OpenNCALayer";
    always-on-top: true;
    min-width: 480px;

    // The requesting page's origin.
    in property <string> origin;
    in property <[StorageRow]> storages;
    // Index of the chosen storage, -1 for none.
    in-out property <int> selected: -1;
    in-out property <string> path;
    // Whether the dialog asks for the key file password.
    in property <bool> ask-password;
    in-out property <string> password;
    in-out property <string> confirmation;
    // Why the answer was refused.
    in-out property <string> error;

    callback browse();
    callback confirm();
    callback cancel();

    private property <bool> can-confirm: root.selected >= 0 && !root.path.is-empty && (!root.ask-password || !root.password.is-empty);

    VerticalBox {
        Text {
            text: @tr("Request from: {}", root.origin);
            wrap: word-wrap;
        }

        Text {
            text: @tr("Certificate request");
            font-weight: 700;
        }

        Text {
            text: @tr("Key storage");
        }

        VerticalLayout {
            for row[i] in root.storages: Rectangle {
                height: 28px;
                border-radius: 4px;
                background: i == root.selected ? Palette.selection-background : transparent;
                accessible-role: list-item;
                accessible-label: row.label;
                accessible-enabled: row.supported;
                accessible-item-selectable: row.supported;
                accessible-item-selected: i == root.selected;
                accessible-item-index: i;
                accessible-item-count: root.storages.length;
                accessible-action-default => {
                    if (row.supported) {
                        root.selected = i;
                    }
                }
                TouchArea {
                    enabled: row.supported;
                    mouse-cursor: row.supported ? pointer : default;
                    clicked => {
                        root.selected = i;
                    }
                }

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    Text {
                        text: row.label;
                        vertical-alignment: center;
                        color: !row.supported ? #888888 : i == root.selected ? Palette.selection-foreground : Palette.foreground;
                    }

                    if !row.supported: Text {
                        text: @tr("not supported yet");
                        vertical-alignment: center;
                        font-italic: true;
                        color: #888888;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        Text {
            text: @tr("Key storage folder");
        }

        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                text <=> root.path;
                horizontal-stretch: 1;
            }

            Button {
                text: @tr("Browse…");
                clicked => {
                    root.browse();
                }
            }
        }

        if root.ask-password: VerticalLayout {
            spacing: 8px;
            Text {
                text: @tr("Password");
            }

            LineEdit {
                text <=> root.password;
                input-type: show-password.checked ? InputType.text : InputType.password;
            }

            Text {
                text: @tr("Confirm password");
            }

            LineEdit {
                text <=> root.confirmation;
                input-type: show-password.checked ? InputType.text : InputType.password;
                accepted => {
                    if (root.can-confirm) {
                        root.confirm();
                    }
                }
            }

            show-password := CheckBox {
                text: @tr("Show password");
            }
        }

        if !root.error.is-empty: Text {
            text: root.error;
            wrap: word-wrap;
            color: #c42b1c;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: @tr("Confirm");
                primary: true;
                enabled: root.can-confirm;
                clicked => {
                    root.confirm();
                }
            }

            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}
