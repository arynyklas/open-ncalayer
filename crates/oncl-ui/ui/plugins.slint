// «Плагины»: the catalog's state, the installed plugins (turn off or on, remove after a
// question, allow an update that may do more), the plugins the catalog offers (install), a
// plugin from a file, and a new download of the catalog. The rows' texts are composed in Rust.

import { Button } from "std-widgets.slint";
import { ActionBar, BusyRow, DialogScroll, EscapeScope, Hint, Metrics, NameText, StatusArea, Subheading, Tone } from "common.slint";

export struct InstalledRow {
    // The name and version.
    title: string,
    // What it replaces, where it came from.
    details: string,
    // On, off, withdrawn, or the error.
    state: string,
    error: bool,
    // Withdrawn plugins cannot be turned on: no button.
    can-toggle: bool,
    enabled: bool,
    // An update waiting for permission and what more it may do, or empty.
    update: string,
}

export struct AvailableRow {
    title: string,
    details: string,
    // «Нужен сайту …», or empty.
    needed: string,
}

export component PluginsWindow inherits Window {
    title: @tr("Plugins");
    min-width: Metrics.wide-min-width;
    min-height: Metrics.wide-min-height;
    preferred-width: 640px;
    preferred-height: 520px;

    in property <string> catalog;
    in property <bool> catalog-error;
    in property <[InstalledRow]> installed;
    in property <[AvailableRow]> available;
    // The outcome of the last action, and whether it failed.
    in property <string> message;
    in property <bool> message-is-error;
    // An action runs: the buttons wait.
    in property <bool> busy;
    // The installed row whose removal is asked about; -1: none.
    in-out property <int> removing: -1;
    in property <string> remove-question;
    // «Close» is inside the window, whatever the texts and the scale.
    out property <bool> actions-reachable: actions.inside(root.width, root.height);

    callback toggle(int);
    callback remove(int);
    callback confirm-remove(int);
    callback confirm-update(int);
    callback install(int);
    callback install-file();
    callback refresh();
    callback dismiss();

    // The question gone (answered or not), the keyboard comes back to the window instead of
    // being lost with the question's button.
    changed removing => {
        if root.removing < 0 {
            keys.focus();
        }
    }

    // Escape works from the first moment: the focus starts here, and Tab goes on from it.
    forward-focus: keys;
    keys := EscapeScope {
        escape => {
            // A question about a removal is answered (no) before the window is left, and a
            // running action's outcome must be seen.
            if root.removing >= 0 {
                root.removing = -1;
            } else if !root.busy {
                root.dismiss();
            }
        }
        VerticalLayout {
            padding: Metrics.pad;
            spacing: Metrics.gap;
            DialogScroll {
                Text {
                    text: root.catalog;
                    wrap: char-wrap;
                    color: root.catalog-error ? Tone.error() : Tone.quiet();
                    font-weight: root.catalog-error ? 700 : 400;
                }

                HorizontalLayout {
                    spacing: Metrics.gap;
                    alignment: start;
                    Button {
                        text: @tr("Install from file…");
                        enabled: !root.busy;
                        clicked => {
                            root.install-file();
                        }
                    }

                    Button {
                        text: @tr("Refresh the catalog");
                        enabled: !root.busy;
                        clicked => {
                            root.refresh();
                        }
                    }
                }

                Subheading {
                    text: @tr("Installed");
                }

                if root.installed.length == 0: Hint {
                    text: @tr("No plugins are installed.");
                }
                for row[i] in root.installed: VerticalLayout {
                    spacing: 4px;
                    NameText {
                        text: row.title;
                        font-weight: 700;
                    }

                    Text {
                        text: row.details;
                        wrap: char-wrap;
                    }

                    Text {
                        text: row.state;
                        wrap: char-wrap;
                        color: row.error ? Tone.error() : Tone.quiet();
                        font-weight: row.error ? 700 : 400;
                    }

                    if row.update != "": Text {
                        text: row.update;
                        wrap: char-wrap;
                        color: Tone.link();
                    }
                    HorizontalLayout {
                        spacing: Metrics.gap;
                        alignment: start;
                        if row.update != "": Button {
                            text: @tr("Allow the update");
                            enabled: !root.busy;
                            clicked => {
                                root.confirm-update(i);
                            }
                        }

                        if row.can-toggle: Button {
                            text: row.enabled ? @tr("Turn off") : @tr("Turn on");
                            enabled: !root.busy;
                            clicked => {
                                root.toggle(i);
                            }
                        }

                        Button {
                            text: @tr("Remove");
                            enabled: !root.busy;
                            clicked => {
                                root.remove(i);
                            }
                        }
                    }
                }

                Subheading {
                    text: @tr("Available in the catalog");
                }

                if root.available.length == 0: Hint {
                    text: @tr("The catalog offers no other plugins.");
                }
                for row[i] in root.available: VerticalLayout {
                    spacing: 4px;
                    NameText {
                        text: row.title;
                        font-weight: 700;
                    }

                    Text {
                        text: row.details;
                        wrap: char-wrap;
                    }

                    if row.needed != "": Text {
                        text: row.needed;
                        wrap: char-wrap;
                        color: Tone.link();
                    }
                    HorizontalLayout {
                        alignment: start;
                        Button {
                            text: @tr("Install…");
                            enabled: !root.busy;
                            clicked => {
                                root.install(i);
                            }
                        }
                    }
                }
            }

            // The question about a removal stays in view, outside the scrolling body; «Cancel»
            // is the default.
            if root.removing >= 0: VerticalLayout {
                spacing: Metrics.gap;
                // The keyboard goes to the question when it appears, on the safe answer.
                init => {
                    cancel-removal.focus();
                }
                StatusArea {
                    message: root.remove-question;
                    neutral: true;
                    limit: 140px;
                }

                ActionBar {
                    Button {
                        text: @tr("Remove");
                        enabled: !root.busy;
                        clicked => {
                            root.confirm-remove(root.removing);
                        }
                    }

                    cancel-removal := Button {
                        text: @tr("Cancel");
                        primary: true;
                        clicked => {
                            root.removing = -1;
                        }
                    }
                }
            }
            if root.busy: BusyRow {
                label: @tr("Please wait…");
            }
            if root.message != "": StatusArea {
                message: root.message;
                error: root.message-is-error;
            }
            actions := ActionBar {
                Button {
                    text: @tr("Close");
                    primary: true;
                    enabled: !root.busy;
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }
    }
}
