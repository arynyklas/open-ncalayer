// The busy indicator between the storage and key dialogs: the key store is opening.

import { BusyRow, Metrics, NameText } from "common.slint";

export component BusyDialog inherits Window {
    title: "OpenNCALayer";
    always-on-top: true;
    min-width: Metrics.dialog-min-width;

    // The requesting page's origin.
    in property <string> origin;

    VerticalLayout {
        padding: Metrics.pad;
        spacing: Metrics.gap;
        alignment: start;
        NameText {
            text: @tr("Request from: {}", root.origin);
        }

        BusyRow {
            label: @tr("Opening the key store…");
        }
    }
}
