// «Остановить оригинал…»: asks before the original NCALayer holding the port is ended, then
// shows how stopping it and starting wss went. The question and the outcome are composed in
// Rust.

import { Button } from "std-widgets.slint";
import { ActionBar, BusyRow, DialogScroll, EscapeScope, Metrics, StatusArea } from "common.slint";

export component StopOriginalWindow inherits Window {
    title: @tr("Stop the original NCALayer");
    min-width: Metrics.dialog-min-width;
    min-height: Metrics.min-height;
    // Ending another program is never the default: Enter alone leaves the window.
    forward-focus: dismiss-button;

    in property <string> question;
    // The outcome, and whether it failed.
    in property <string> message;
    in property <bool> message-is-error;
    // Stopping runs: the buttons wait.
    in property <bool> busy;
    // Stopped: only «Закрыть» is left.
    in property <bool> done;
    // The buttons are inside the window, whatever the text and the scale.
    out property <bool> actions-reachable: actions.inside(root.width, root.height);

    callback stop();
    callback dismiss();

    EscapeScope {
        escape => {
            // Stopping runs: its outcome must be seen.
            if !root.busy {
                root.dismiss();
            }
        }
        VerticalLayout {
            padding: Metrics.pad;
            spacing: Metrics.gap;
            DialogScroll {
                Text {
                    text: root.question;
                    wrap: char-wrap;
                }
            }

            if root.busy: BusyRow {
                label: @tr("Please wait…");
            }
            if !root.message.is-empty: StatusArea {
                message: root.message;
                error: root.message-is-error;
            }
            actions := ActionBar {
                if !root.done: Button {
                    text: @tr("Stop");
                    enabled: !root.busy;
                    clicked => {
                        root.stop();
                    }
                }

                // The default, as in every question that cannot be undone.
                dismiss-button := Button {
                    text: root.done ? @tr("Close") : @tr("Cancel");
                    primary: true;
                    enabled: !root.busy;
                    clicked => {
                        root.dismiss();
                    }
                }
            }
        }
    }
}
