// A plugin's message: who shows it, how it looks and its text (plain text, not markup).

import { Button, Palette } from "std-widgets.slint";
import { ActionBar, DialogScroll, EscapeScope, Metrics, Subheading, Tone } from "common.slint";

export component MessageDialog inherits Window {
    title: "OpenNCALayer";
    always-on-top: true;
    min-width: Metrics.dialog-min-width;
    min-height: Metrics.min-height;
    max-width: 640px;
    forward-focus: ok-button;

    // The requesting page's origin.
    in property <string> origin;
    // The plugin's name.
    in property <string> source;
    // 0: information, 1: warning, 2: error.
    in property <int> kind;
    // The plugin's text.
    in property <string> text;
    // The translated header lines.
    out property <string> requester: @tr("Request from: {}", root.origin);
    out property <string> heading: root.kind == 2 ? @tr("Error") : root.kind == 1 ? @tr("Warning") : @tr("Information");
    // The buttons are inside the window, whatever the text and the scale.
    out property <bool> actions-reachable: actions.inside(root.width, root.height);

    callback ok();
    callback cancel();

    EscapeScope {
        escape => {
            root.cancel();
        }
        VerticalLayout {
            padding: Metrics.pad;
            spacing: Metrics.gap;
            DialogScroll {
                Text {
                    text: root.requester;
                    wrap: char-wrap;
                }

                Text {
                    text: @tr("Plugin: {}", root.source);
                    wrap: char-wrap;
                }

                Subheading {
                    text: root.heading;
                    color: root.kind == 2 ? Tone.error() : root.kind == 1 ? Tone.warning() : Palette.foreground;
                }

                Text {
                    text: root.text;
                    wrap: char-wrap;
                }
            }

            actions := ActionBar {
                ok-button := Button {
                    text: @tr("OK");
                    primary: true;
                    clicked => {
                        root.ok();
                    }
                }
            }
        }
    }
}
