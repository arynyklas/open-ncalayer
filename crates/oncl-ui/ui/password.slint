// The password dialog of the legacy Applet's setPassword: who asks, the page's text and the
// password.

import { Button, CheckBox, LineEdit, VerticalBox } from "std-widgets.slint";

export component PasswordDialog inherits Window {
    title: "OpenNCALayer";
    always-on-top: true;
    min-width: 420px;
    forward-focus: password-input;

    // The requesting page's origin.
    in property <string> origin;
    // The page's text; empty for the default request.
    in property <string> message;
    in-out property <string> password;

    callback confirm();
    callback cancel();

    VerticalBox {
        Text {
            text: @tr("Request from: {}", root.origin);
            wrap: word-wrap;
        }

        Text {
            text: root.message.is-empty ? @tr("Enter the key store password:") : root.message;
            font-weight: 700;
            wrap: word-wrap;
        }

        Text {
            text: @tr("Password");
        }

        password-input := LineEdit {
            text <=> root.password;
            input-type: show-password.checked ? InputType.text : InputType.password;
            accepted => {
                root.confirm();
            }
        }

        show-password := CheckBox {
            text: @tr("Show password");
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: @tr("OK");
                primary: true;
                clicked => {
                    root.confirm();
                }
            }

            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}
