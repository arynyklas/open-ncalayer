// A password dialog: the legacy Applet's setPassword, or a plugin's. Who asks, the text,
// the password; a plugin may name the heading and the buttons, and require a password.

import { Button, CheckBox } from "std-widgets.slint";
import { ActionBar, DialogScroll, EscapeScope, Metrics, NameText, Subheading, TextField } from "common.slint";

export component PasswordDialog inherits Window {
    title: "OpenNCALayer";
    always-on-top: true;
    min-width: Metrics.dialog-min-width;
    min-height: Metrics.min-height;
    forward-focus: password-input;

    // The requesting page's origin.
    in property <string> origin;
    // The plugin's name; empty for a module.
    in property <string> source;
    // The plugin's heading; empty: none.
    in property <string> heading;
    // The page's or plugin's text; empty for the default request.
    in property <string> message;
    // The plugin's button texts; empty: OK and Cancel.
    in property <string> ok-text;
    in property <string> cancel-text;
    // Whether OK takes an empty password.
    in property <bool> allow-empty: true;
    in-out property <string> password;
    // The translated lines, as shown.
    out property <string> requester: @tr("Request from: {}", root.origin);
    out property <string> plugin-line: root.source.is-empty ? "" : @tr("Plugin: {}", root.source);
    out property <string> label: root.message.is-empty ? @tr("Enter the key store password:") : root.message;
    out property <string> ok-label: root.ok-text.is-empty ? @tr("OK") : root.ok-text;
    out property <string> cancel-label: root.cancel-text.is-empty ? @tr("Cancel") : root.cancel-text;
    out property <bool> can-confirm: root.allow-empty || !root.password.is-empty;
    // The buttons are inside the window, whatever the text and the scale.
    out property <bool> actions-reachable: actions.inside(root.width, root.height);

    callback confirm();
    callback cancel();

    EscapeScope {
        escape => {
            root.cancel();
        }
        VerticalLayout {
            padding: Metrics.pad;
            spacing: Metrics.gap;
            DialogScroll {
                NameText {
                    text: root.requester;
                }

                if !root.source.is-empty: NameText {
                    text: root.plugin-line;
                }

                if !root.heading.is-empty: Subheading {
                    text: root.heading;
                }

                Text {
                    text: root.label;
                    font-weight: root.heading.is-empty ? 700 : 400;
                    wrap: word-wrap;
                }

                password-input := TextField {
                    label: @tr("Password");
                    secret: !show-password.checked;
                    text <=> root.password;
                    accepted => {
                        if root.can-confirm {
                            root.confirm();
                        }
                    }
                }

                show-password := CheckBox {
                    text: @tr("Show password");
                }
            }

            actions := ActionBar {
                Button {
                    text: root.ok-label;
                    primary: true;
                    enabled: root.can-confirm;
                    clicked => {
                        root.confirm();
                    }
                }

                Button {
                    text: root.cancel-label;
                    clicked => {
                        root.cancel();
                    }
                }
            }
        }
    }
}
