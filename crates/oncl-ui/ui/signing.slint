// The signing page of the tools window: one operation in one place, step by step: documents
// and key store → password and certificate → the confirmation that names the action → the
// result. The caller and the action stay on screen in every step. All texts that depend on
// the state are composed in Rust.

import { Button, CheckBox, ComboBox, LineEdit, Palette, ScrollView, StandardListView, TextEdit } from "std-widgets.slint";
import { ReportRow, ReportView } from "report.slint";
import { ErrorText, FieldLabel, Heading } from "common.slint";

export global SigningState {
    // 0: documents and key store, 1: password and certificate, 2: confirmation, 3: running,
    // 4: result.
    in property <int> step;
    in property <string> step-title;
    // «Request from … · Action …»: composed by the host, never from a document.
    in property <string> trust-line;
    in-out property <string> doc-path;
    in property <[StandardListViewItem]> docs;
    in property <[string]> recent;
    in-out property <int> recent-index: -1;
    in property <[string]> recent-stores;
    in-out property <int> recent-store-index: -1;
    in-out property <string> store-path;
    in-out property <string> password;
    in property <[StandardListViewItem]> certs;
    in-out property <int> cert-index: -1;
    in property <[StandardListViewItem]> frozen;
    in property <string> cert-line;
    // Where the signature files will be written.
    in property <string> outputs;
    in property <string> confirm-label;
    // The documents are frozen by the engine: until then the action cannot be confirmed.
    in property <bool> frozen-ready;
    // The confirmation may be pressed: it is the step, the documents are frozen and the page has
    // been quiet. Set by the host from the controller, never from a running job: the job that
    // freezes the documents waits for this very button.
    in property <bool> confirm-enabled;
    in property <string> favorite-label;
    in property <string> result;
    in property <string> error;
    in property <bool> busy;
    // What is made of the documents. The format is a family; the level is for the formats that
    // have one (CMS/CAdES, XML/XAdES, PDF/PAdES).
    // 0: CMS/CAdES, 1: XML/XAdES, 2: WS-Security, 3: PDF/PAdES, 4: JWS, 5: JWT.
    in-out property <int> format-index: 0;
    // 0: plain, 1: B, 2: T, 3: LT, 4: LTA.
    in-out property <int> level-index: 0;
    // 0: next to each document, 1: one folder.
    in-out property <int> destination-index: 0;
    in-out property <string> destination-path;
    // The options that are rarely needed stay folded until asked for.
    in-out property <bool> show-advanced: false;
    in-out property <bool> attached: false;
    in-out property <bool> add-signature: false;
    in-out property <string> xml-target;
    in-out property <string> xml-parent;
    in-out property <string> signature-id;
    // LT and LTA of CAdES and PAdES: the files their evidence is built from, each field a list
    // of paths separated by «;».
    in-out property <string> evidence-certificates;
    in-out property <string> evidence-ocsp;
    in-out property <string> evidence-crls;
    // «Format … · options …» of the operation, shown at the confirmation.
    in property <string> profile-line;
    // The report of the result: how the batch ended, then each document, signer and check.
    in property <string> report-headline;
    in property <int> report-tone: 3;
    in property <[ReportRow]> report-rows;

    callback add-doc();
    callback clear-docs();
    callback pick-recent();
    callback pick-recent-store();
    callback browse-doc();
    callback browse-store();
    callback to-unlock();
    callback unlock();
    // A click on a certificate: the host tells a double-click from two single ones.
    callback cert-clicked(int);
    // Enter in the list or a double-click: shows the confirmation, signs nothing.
    callback cert-chosen(int);
    callback toggle-favorite();
    callback clear-remembered();
    callback confirm();
    callback back();
    callback cancel();
    callback finish();
    callback browse-folder();
}

export component SigningPage inherits VerticalLayout {
    spacing: 8px;
    Heading {
        text: SigningState.step-title;
    }

    Rectangle {
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 4px;
        VerticalLayout {
            padding: 8px;
            Text {
                text: SigningState.trust-line;
                wrap: word-wrap;
                accessible-role: text;
            }
        }
    }

    if SigningState.step == 0: VerticalLayout {
        spacing: 8px;
        FieldLabel {
            text: @tr("Documents to sign");
        }

        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                horizontal-stretch: 1;
                enabled: !SigningState.busy;
                text <=> SigningState.doc-path;
                placeholder-text: @tr("Path to the file");
                accessible-label: @tr("Documents to sign");
                accepted => {
                    SigningState.add-doc();
                }
            }

            Button {
                text: @tr("Browse…");
                clicked => {
                    SigningState.browse-doc();
                }
            }

            Button {
                text: @tr("Add");
                clicked => {
                    SigningState.add-doc();
                }
            }
        }

        if SigningState.recent.length > 0: HorizontalLayout {
            spacing: 8px;
            Text {
                text: @tr("Recent");
                vertical-alignment: center;
            }

            ComboBox {
                horizontal-stretch: 1;
                model: SigningState.recent;
                current-index <=> SigningState.recent-index;
                accessible-label: @tr("Recent");
                selected => {
                    SigningState.pick-recent();
                }
            }

            Button {
                text: @tr("Forget recent and favourites");
                clicked => {
                    SigningState.clear-remembered();
                }
            }
        }
        StandardListView {
            height: 90px;
            model: SigningState.docs;
            accessible-label: @tr("Documents to sign");
        }

        FieldLabel {
            text: @tr("Format of the signature");
        }

        HorizontalLayout {
            spacing: 8px;
            ComboBox {
                horizontal-stretch: 1;
                model: [@tr("CMS / CAdES (signature file)"), @tr("XML (XMLDSig / XAdES)"), @tr("SOAP message (WS-Security)"), @tr("PDF (PAdES)"), @tr("JWS (JSON Web Signature)"), @tr("JWT (signed token)")];
                current-index <=> SigningState.format-index;
                accessible-label: @tr("Format of the signature");
            }

            if SigningState.format-index == 0 || SigningState.format-index == 1 || SigningState.format-index == 3: ComboBox {
                model: [@tr("Plain, no level"), @tr("B: basic"), @tr("T: with a time stamp"), @tr("LT: with validation data"), @tr("LTA: for long-term archival")];
                current-index <=> SigningState.level-index;
                accessible-label: @tr("Level of the signature");
            }
        }

        FieldLabel {
            text: @tr("Where the results are written");
        }

        HorizontalLayout {
            spacing: 8px;
            ComboBox {
                model: [@tr("Next to each document"), @tr("In one folder")];
                current-index <=> SigningState.destination-index;
                accessible-label: @tr("Where the results are written");
            }

            if SigningState.destination-index == 1: LineEdit {
                horizontal-stretch: 1;
                text <=> SigningState.destination-path;
                placeholder-text: @tr("Path to the folder");
                accessible-label: @tr("Folder for the results");
            }
            if SigningState.destination-index == 1: Button {
                text: @tr("Browse…");
                clicked => {
                    SigningState.browse-folder();
                }
            }
        }

        CheckBox {
            text: @tr("Show the options that are rarely needed");
            checked <=> SigningState.show-advanced;
            accessible-label: @tr("Show the options that are rarely needed");
        }

        if SigningState.show-advanced: VerticalLayout {
            spacing: 6px;
            if SigningState.format-index == 0: CheckBox {
                text: @tr("Put the content inside the signature (attached)");
                checked <=> SigningState.attached;
                accessible-label: @tr("Put the content inside the signature (attached)");
            }
            if SigningState.format-index == 1 || SigningState.format-index == 2: CheckBox {
                text: @tr("Add a signature to a document that is already signed");
                checked <=> SigningState.add-signature;
                accessible-label: @tr("Add a signature to a document that is already signed");
            }
            if SigningState.format-index == 1: VerticalLayout {
                spacing: 4px;
                FieldLabel {
                    text: @tr("Element to sign (XML ID)");
                }

                LineEdit {
                    text <=> SigningState.xml-target;
                    accessible-label: @tr("Element to sign (XML ID)");
                }

                FieldLabel {
                    text: @tr("Element that gets the signature (XML ID)");
                }

                LineEdit {
                    text <=> SigningState.xml-parent;
                    accessible-label: @tr("Element that gets the signature (XML ID)");
                }

                FieldLabel {
                    text: @tr("Identity of the signature (XML ID)");
                }

                LineEdit {
                    text <=> SigningState.signature-id;
                    accessible-label: @tr("Identity of the signature (XML ID)");
                }
            }
        }
            if (SigningState.format-index == 0 || SigningState.format-index == 3) && SigningState.level-index >= 3: VerticalLayout {
                spacing: 4px;
                FieldLabel {
                    text: @tr("Evidence: certificates of the chain (files, separated by ;)");
                }

                LineEdit {
                    text <=> SigningState.evidence-certificates;
                    accessible-label: @tr("Evidence: certificates of the chain (files, separated by ;)");
                }

                FieldLabel {
                    text: @tr("Evidence: OCSP responses (files, separated by ;)");
                }

                LineEdit {
                    text <=> SigningState.evidence-ocsp;
                    accessible-label: @tr("Evidence: OCSP responses (files, separated by ;)");
                }

                FieldLabel {
                    text: @tr("Evidence: CRLs (files, separated by ;)");
                }

                LineEdit {
                    text <=> SigningState.evidence-crls;
                    accessible-label: @tr("Evidence: CRLs (files, separated by ;)");
                }
            }

        FieldLabel {
            text: @tr("Key store (PKCS#12, JKS)");
        }

        HorizontalLayout {
            spacing: 8px;
            LineEdit {
                horizontal-stretch: 1;
                text <=> SigningState.store-path;
                placeholder-text: @tr("Path to the file");
                accessible-label: @tr("Key store (PKCS#12, JKS)");
                accepted => {
                    SigningState.to-unlock();
                }
            }

            Button {
                text: @tr("Browse…");
                clicked => {
                    SigningState.browse-store();
                }
            }
        }

        if SigningState.recent-stores.length > 0: HorizontalLayout {
            spacing: 8px;
            Text {
                text: @tr("Recent key stores");
                vertical-alignment: center;
            }

            ComboBox {
                horizontal-stretch: 1;
                model: SigningState.recent-stores;
                current-index <=> SigningState.recent-store-index;
                accessible-label: @tr("Recent key stores");
                selected => {
                    SigningState.pick-recent-store();
                }
            }
        }
        if SigningState.error != "": ErrorText {
            text: SigningState.error;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                text: @tr("Continue");
                primary: true;
                clicked => {
                    SigningState.to-unlock();
                }
            }

            Button {
                text: @tr("Clear documents");
                clicked => {
                    SigningState.clear-docs();
                }
            }
        }
    }
    if SigningState.step == 1: VerticalLayout {
        spacing: 8px;
        FieldLabel {
            text: @tr("Password of the key store");
        }

        LineEdit {
            enabled: !SigningState.busy;
            input-type: password;
            text <=> SigningState.password;
            accessible-label: @tr("Password of the key store");
            // Enter opens the key store and shows its certificates; it agrees to nothing.
            accepted => {
                SigningState.unlock();
            }
        }

        if SigningState.error != "": ErrorText {
            text: SigningState.error;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            Button {
                text: @tr("Open key store");
                primary: SigningState.certs.length == 0;
                enabled: !SigningState.busy;
                clicked => {
                    SigningState.unlock();
                }
            }

            Button {
                text: @tr("Back");
                enabled: !SigningState.busy;
                clicked => {
                    SigningState.back();
                }
            }
        }

        if SigningState.certs.length > 0: VerticalLayout {
            spacing: 8px;
            FieldLabel {
                text: @tr("Choose the certificate");
            }

            FocusScope {
                // The list is the stop of the Tab ring (it has its own name); this scope only
                // takes Enter from it.
                focus-on-tab-navigation: false;
                key-pressed(event) => {
                    if event.text == "\n" && SigningState.cert-index >= 0 {
                        SigningState.cert-chosen(SigningState.cert-index);
                        return accept;
                    }
                    reject
                }
                StandardListView {
                    height: 120px;
                    model: SigningState.certs;
                    current-item <=> SigningState.cert-index;
                    accessible-label: @tr("Choose the certificate");
                    item-pointer-event(i, event, position) => {
                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                            SigningState.cert-clicked(i);
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: @tr("Show the confirmation");
                    enabled: SigningState.cert-index >= 0;
                    clicked => {
                        SigningState.cert-chosen(SigningState.cert-index);
                    }
                }

                Button {
                    text: SigningState.favorite-label;
                    enabled: SigningState.cert-index >= 0;
                    clicked => {
                        SigningState.toggle-favorite();
                    }
                }
            }
        }
    }
    if SigningState.step == 2: VerticalLayout {
        spacing: 8px;
        FieldLabel {
            text: @tr("Certificate");
        }

        Text {
            text: SigningState.cert-line;
            wrap: word-wrap;
        }

        Text {
            text: SigningState.outputs;
            wrap: word-wrap;
        }

        Text {
            text: SigningState.profile-line;
            wrap: word-wrap;
        }

        FieldLabel {
            text: @tr("Documents (names are as given, not checked)");
        }

        StandardListView {
            height: 110px;
            model: SigningState.frozen;
            accessible-label: @tr("Documents (names are as given, not checked)");
        }

        if SigningState.error != "": ErrorText {
            text: SigningState.error;
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            // The one button that agrees; it names the action. Enter does not press it.
            Button {
                text: SigningState.confirm-label;
                primary: true;
                enabled: SigningState.confirm-enabled;
                clicked => {
                    SigningState.confirm();
                }
            }

            Button {
                text: @tr("Back");
                clicked => {
                    SigningState.back();
                }
            }

            Button {
                text: @tr("Cancel");
                clicked => {
                    SigningState.cancel();
                }
            }
        }
    }
    if SigningState.step == 3: VerticalLayout {
        spacing: 8px;
        Text {
            text: SigningState.result;
            wrap: word-wrap;
        }

        HorizontalLayout {
            alignment: start;
            Button {
                text: @tr("Cancel");
                clicked => {
                    SigningState.cancel();
                }
            }
        }
    }
    if SigningState.step == 4: VerticalLayout {
        spacing: 8px;
        if SigningState.result != "": Text {
            text: SigningState.result;
            wrap: word-wrap;
            accessible-role: text;
            accessible-label: SigningState.result;
        }
        ReportView {
            headline: SigningState.report-headline;
            tone: SigningState.report-tone;
            rows: SigningState.report-rows;
        }

        HorizontalLayout {
            alignment: start;
            Button {
                text: @tr("New signing");
                primary: true;
                clicked => {
                    SigningState.finish();
                }
            }
        }
    }
}
