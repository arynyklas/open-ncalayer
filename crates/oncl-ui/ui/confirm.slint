// A plugin's yes/no question: who asks and the question (plain text, not markup).

import { Button } from "std-widgets.slint";
import { ActionBar, DialogScroll, EscapeScope, Metrics, NameText, Subheading } from "common.slint";

export component ConfirmDialog inherits Window {
    title: "OpenNCALayer";
    always-on-top: true;
    min-width: Metrics.dialog-min-width;
    min-height: Metrics.min-height;
    max-width: 640px;
    forward-focus: no-button;

    // The requesting page's origin.
    in property <string> origin;
    // The plugin's name.
    in property <string> source;
    // The plugin's question.
    in property <string> text;
    // The translated header line.
    out property <string> requester: @tr("Request from: {}", root.origin);
    // The buttons are inside the window, whatever the text and the scale.
    out property <bool> actions-reachable: actions.inside(root.width, root.height);
    // How far the text is scrolled (zero or negative).
    out property <length> body-y: body.content-y;

    callback answer(bool);
    callback cancel();

    EscapeScope {
        escape => {
            root.cancel();
        }
        VerticalLayout {
            padding: Metrics.pad;
            spacing: Metrics.gap;
            body := DialogScroll {
                NameText {
                    text: root.requester;
                }

                NameText {
                    text: @tr("Plugin: {}", root.source);
                }

                Subheading {
                    text: root.text;
                }
            }

            actions := ActionBar {
                Button {
                    text: @tr("Yes");
                    clicked => {
                        root.answer(true);
                    }
                }

                // The default: a question answered by Enter alone is not a yes.
                no-button := Button {
                    text: @tr("No");
                    primary: true;
                    clicked => {
                        root.answer(false);
                    }
                }
            }
        }
    }
}
