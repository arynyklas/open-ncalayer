// The key dialog: one row per key of the opened store. Rows of keys whose OCSP check is
// still running show a spinner and change in place when it ends.

import { Button, ListView, Palette, Spinner, VerticalBox } from "std-widgets.slint";

// A key in the list.
export struct KeyItem {
    title: string,
    details: string,
    // Only enabled keys may sign.
    enabled: bool,
    // Its certificate status is still being checked: not enabled yet.
    pending: bool,
    // Why the key may not sign; empty if it may or is still being checked.
    note: string,
    // The revocation mark, `revoked <date>`; empty unless the key is revoked.
    revoked: string,
}

export component KeyDialog inherits Window {
    title: "OpenNCALayer";
    always-on-top: true;
    min-width: 520px;
    min-height: 320px;

    // The requesting page's origin.
    in property <string> origin;
    // Authentication rather than signing.
    in property <bool> authenticate;
    // Handing the key's certificate details to the page: nothing is signed.
    in property <bool> key-info;
    // A line about the request, e.g. the file to be signed; empty for none.
    in property <string> detail;
    // Why the previous choice failed; empty for none.
    in property <string> error;
    in property <[KeyItem]> keys;
    // Whether any key is enabled or still being checked.
    in property <bool> has-usable;
    // Index of the chosen key, -1 for none.
    in-out property <int> selected: -1;

    callback sign();
    callback cancel();

    // Whether OK may be pressed: the selected key is enabled.
    out property <bool> can-sign: root.selected >= 0 && root.keys[root.selected].enabled;

    VerticalBox {
        Text {
            text: @tr("Request from: {}", root.origin);
            wrap: word-wrap;
        }

        Text {
            text: root.key-info ? @tr("Action: key information") : root.authenticate ? @tr("Action: authentication") : @tr("Action: signing");
            font-weight: 700;
        }

        if !root.detail.is-empty: Text {
            text: root.detail;
            wrap: word-wrap;
        }

        Text {
            text: root.has-usable ? @tr("Choose a key") : @tr("No suitable key found");
            color: root.has-usable ? Palette.foreground : #c42b1c;
        }

        ListView {
            vertical-stretch: 1;
            min-height: 160px;
            for row[i] in root.keys: Rectangle {
                border-radius: 4px;
                background: i == root.selected ? Palette.selection-background : transparent;
                accessible-role: list-item;
                accessible-label: row.title;
                accessible-description: row.pending ? row.details + "\n" + @tr("Checking the certificate status…") : row.note.is-empty ? row.details : row.details + "\n" + row.note;
                accessible-item-selectable: true;
                accessible-item-selected: i == root.selected;
                accessible-item-index: i;
                accessible-item-count: root.keys.length;
                accessible-action-default => {
                    root.selected = i;
                }
                TouchArea {
                    clicked => {
                        root.selected = i;
                    }
                    double-clicked => {
                        root.selected = i;
                        if (root.can-sign) {
                            root.sign();
                        }
                    }
                }

                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    Text {
                        text: row.title;
                        font-weight: 700;
                        color: !row.enabled && !row.pending ? #888888 : i == root.selected ? Palette.selection-foreground : Palette.foreground;
                    }

                    Text {
                        text: row.details;
                        wrap: word-wrap;
                        color: !row.enabled && !row.pending ? #888888 : i == root.selected ? Palette.selection-foreground : Palette.foreground;
                    }

                    if row.pending: HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        // On the selected row the spinner sits on the window colour, so it
                        // stands out from the selection background.
                        Rectangle {
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            background: i == root.selected ? Palette.background : transparent;
                            Spinner {
                                indeterminate: true;
                                width: 14px;
                                height: 14px;
                            }
                        }

                        Text {
                            text: @tr("Checking the certificate status…");
                            vertical-alignment: center;
                            font-italic: true;
                            color: i == root.selected ? Palette.selection-foreground : #888888;
                        }
                    }

                    if !row.revoked.is-empty: Text {
                        text: row.revoked;
                        font-weight: 700;
                        color: #c42b1c;
                    }
                }
            }
        }

        if root.selected >= 0 && !root.keys[root.selected].enabled && !root.keys[root.selected].note.is-empty: Text {
            text: root.keys[root.selected].note;
            wrap: word-wrap;
            color: #c42b1c;
        }

        if !root.error.is-empty: Text {
            text: root.error;
            wrap: word-wrap;
            color: #c42b1c;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: root.key-info ? @tr("Send") : @tr("Sign");
                primary: true;
                enabled: root.can-sign;
                clicked => {
                    root.sign();
                }
            }

            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}
