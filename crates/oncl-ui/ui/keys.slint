// The key dialog: one row per key of the opened store.

import { Button, ListView, Palette, VerticalBox } from "std-widgets.slint";

// A key in the list.
export struct KeyItem {
    title: string,
    details: string,
    // Only enabled keys may sign.
    enabled: bool,
    // Why the key may not sign; empty if it may.
    note: string,
    // The revocation mark, `revoked <date>`; empty unless the key is revoked.
    revoked: string,
}

export component KeyDialog inherits Window {
    title: "OpenNCALayer";
    always-on-top: true;
    min-width: 520px;
    min-height: 320px;

    // The requesting page's origin.
    in property <string> origin;
    // Authentication rather than signing.
    in property <bool> authenticate;
    // Handing the key's certificate details to the page: nothing is signed.
    in property <bool> key-info;
    // A line about the request, e.g. the file to be signed; empty for none.
    in property <string> detail;
    // Why the previous choice failed; empty for none.
    in property <string> error;
    in property <[KeyItem]> keys;
    // Whether any key is enabled.
    in property <bool> has-enabled;
    // Index of the chosen key, -1 for none.
    in-out property <int> selected: -1;

    callback sign();
    callback cancel();

    private property <bool> can-sign: root.selected >= 0 && root.keys[root.selected].enabled;

    VerticalBox {
        Text {
            text: @tr("Request from: {}", root.origin);
            wrap: word-wrap;
        }

        Text {
            text: root.key-info ? @tr("Action: key information") : root.authenticate ? @tr("Action: authentication") : @tr("Action: signing");
            font-weight: 700;
        }

        if !root.detail.is-empty: Text {
            text: root.detail;
            wrap: word-wrap;
        }

        Text {
            text: root.has-enabled ? @tr("Choose a key") : @tr("No suitable key found");
            color: root.has-enabled ? Palette.foreground : #c42b1c;
        }

        ListView {
            vertical-stretch: 1;
            min-height: 160px;
            for row[i] in root.keys: Rectangle {
                border-radius: 4px;
                background: i == root.selected ? Palette.selection-background : transparent;
                accessible-role: list-item;
                accessible-label: row.title;
                accessible-description: row.note.is-empty ? row.details : row.details + "\n" + row.note;
                accessible-item-selectable: true;
                accessible-item-selected: i == root.selected;
                accessible-item-index: i;
                accessible-item-count: root.keys.length;
                accessible-action-default => {
                    root.selected = i;
                }
                TouchArea {
                    clicked => {
                        root.selected = i;
                    }
                    double-clicked => {
                        root.selected = i;
                        if (root.can-sign) {
                            root.sign();
                        }
                    }
                }

                VerticalLayout {
                    padding: 8px;
                    spacing: 2px;
                    Text {
                        text: row.title;
                        font-weight: 700;
                        color: !row.enabled ? #888888 : i == root.selected ? Palette.selection-foreground : Palette.foreground;
                    }

                    Text {
                        text: row.details;
                        wrap: word-wrap;
                        color: !row.enabled ? #888888 : i == root.selected ? Palette.selection-foreground : Palette.foreground;
                    }

                    if !row.revoked.is-empty: Text {
                        text: row.revoked;
                        font-weight: 700;
                        color: #c42b1c;
                    }
                }
            }
        }

        if root.selected >= 0 && !root.keys[root.selected].enabled: Text {
            text: root.keys[root.selected].note;
            wrap: word-wrap;
            color: #c42b1c;
        }

        if !root.error.is-empty: Text {
            text: root.error;
            wrap: word-wrap;
            color: #c42b1c;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                text: root.key-info ? @tr("Send") : @tr("Sign");
                primary: true;
                enabled: root.can-sign;
                clicked => {
                    root.sign();
                }
            }

            Button {
                text: @tr("Cancel");
                clicked => {
                    root.cancel();
                }
            }
        }
    }
}
