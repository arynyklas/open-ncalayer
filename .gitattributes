# Fixtures are compared byte for byte (`cargo xtask gen-fixtures --check`, sha256 sums,
# DER parsers): no end-of-line conversion.
fixtures/** -text
# Shell scripts run under bash, which rejects CRLF (`bad interpreter`).
*.sh text eol=lf
# Vendored as published (sha256 pinned in the e2e tests): no end-of-line conversion.
web/demo/vendor/** -text
# Generated by `cargo xtask licenses` and compared byte for byte by its `--check`.
crates/oncl-ui/assets/THIRD-PARTY.txt text eol=lf
xtask/licenses/*.txt text eol=lf
# Update indexes are signed byte for byte (`cargo xtask sign`) and published as committed:
# no end-of-line conversion.
updates/** -text
# Vendored as published, with the patches the README and NOTICE describe: no end-of-line
# conversion.
vendor/** -text
